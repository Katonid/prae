<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Die App ist deutsch und bringt keine Sprachdateien mit. Ohne diese
	     beiden Schlüssel setzt Xcode „en", und iOS zeigt daraufhin ALLES
	     Systemeigene englisch — Fotowähler, Dateiwähler, Teilen-Blatt,
	     „Abbrechen". Dieselbe Falle wie bei Tafelbild 1.0.59. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
	</array>

	<!-- Der Fotowähler selbst braucht KEINE Berechtigung — er läuft in einem
	     eigenen Prozess. Die Berechtigung braucht nur der Umweg dahinter:
	     Ohne sie entfernt iOS die Standortdaten aus den herausgegebenen
	     Bilddaten, und die Reisespur bliebe leer. Mit ihr liest die App den
	     Aufnahmeort am Mediathekseintrag nach. Wer ablehnt, kann alles
	     weiter benutzen und setzt die Punkte auf der Karte. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Damit die App den Aufnahmeort deiner Fotos lesen und daraus die Reisespur zeichnen kann. Ohne diese Erlaubnis gibt iOS die Orte nicht heraus; die Fotos lassen sich trotzdem einsetzen, und du kannst die Punkte selbst auf der Karte wählen.</string>

	<!-- Nur „WhenInUse", und nur als Bequemlichkeit: Wer gerade an dem Ort
	     steht, den er eintragen will, soll ihn nicht auf der Karte suchen
	     müssen. Ohne Ortung fehlt genau dieser eine Knopf. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Damit du beim Setzen eines Reisepunktes deinen jetzigen Standort übernehmen kannst, statt ihn auf der Karte zu suchen. Der Standort bleibt auf dem Gerät.</string>
	<!-- Der Ordner der App im iCloud-Laufwerk wird SICHTBAR. Ohne diese
	     drei Schlüssel läge er versteckt im Behälter, und niemand käme an
	     seine Bücher heran, wenn die App einmal nicht mehr da ist. Eine
	     Ablage, die man nur mit der App wieder aufbekommt, ist bei einem
	     Tagebuch die falsche. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.de.familie.urlaubstagebuch</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Reisebuch</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>

	<!-- Das eigene Dateiformat, damit der Dateiwähler es filtern kann und
	     eine Buchdatei in „Dateien" ein Symbol und einen Namen hat statt
	     „Dokument". -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.familie.urlaubstagebuch.buch</string>
			<key>UTTypeDescription</key>
			<string>Reisebuch</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>reisebuch</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- Eine Buchdatei, die jemand in „Dateien" antippt oder per AirDrop
	     schickt, soll bei dieser App landen. Nicht „an Ort und Stelle":
	     Die App kopiert beim Einlesen ohnehin in ihre eigene Ablage, und
	     ein Buch, das noch in einem fremden Ordner liegt, wäre beim
	     nächsten Öffnen vielleicht nicht mehr da. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Reisebuch</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.familie.urlaubstagebuch.buch</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
