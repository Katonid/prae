<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Wallet-Pass</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.pkpass</string>
			</array>
		</dict>
	</array>
	<!-- Bewusst KEINE eigene UTImportedTypeDeclaration für com.apple.pkpass:
	     Eine Fremd-Deklaration eines System-Dateityps kann dessen
	     System-Deklaration verschatten — dann behandelt iOS .pkpass als
	     generische Daten und die Wallet übernimmt das Antippen nicht mehr
	     (genau der Effekt, den Pass2U auf dem Gerät hinterlassen hatte). -->

</dict>
</plist>
