<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Die App ist deutsch und bringt keine Sprachdateien mit. Ohne diese
	     beiden Schlüssel zeigt iOS alles Systemeigene englisch — auch das
	     Teilen-Blatt der Reise (Lehre aus Tafelbild 1.0.59). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
	</array>

	<!-- Reisen werden über CKShare geteilt: Ohne diesen Schlüssel öffnet
	     ein Einladungslink die App, kommt aber nirgends an. -->
	<key>CKSharingSupported</key>
	<true/>

	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>Reisespur</key>
		<string>Mit der ungefähren Ortung liegt jeder Punkt der Reisespur mehrere hundert Meter daneben. Für die Spur braucht die App den genauen Standort.</string>
	</dict>

	<!-- Die Texte der Berechtigungsabfragen stehen als Build-Einstellung
	     (INFOPLIST_KEY_…) im pbxproj, nicht hier. Standen sie hier, wollte
	     Xcode sie beim Öffnen des Reiters „General“ selbst dorthin umziehen
	     und brach dabei ab (Xcode 27, Absturz beim Öffnen des Projekts). -->

	<!-- location: die Reisespur im Hintergrund.
	     remote-notification: CloudKit meldet Änderungen der Miturlauber
	     über stille Pushes. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
