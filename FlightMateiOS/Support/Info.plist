<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hintergrund-Aktualisierung (BGAppRefresh): Wetter an den Spots
	     prüfen und Flugfenster-Benachrichtigungen neu planen. Xcode
	     ergänzt diese Datei automatisch um die generierten Schlüssel
	     (GENERATE_INFOPLIST_FILE bleibt aktiv). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>de.familie.flightmate.refresh</string>
	</array>
	<!-- remote-notification: CloudKit stößt damit den Katalog-Sync
	     des Archivs an, sobald ein anderes Gerät etwas ändert. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<!-- Foto-Mediathek: Der Archiv-Import liest Original-Dateien und
	     Metadaten über PhotoKit. OHNE diesen Text beendet iOS die App
	     beim ersten Berechtigungs-Zugriff sofort (war der gemeldete
	     Import-Absturz). -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FlightMate liest deine Drohnen-Fotos und -Videos aus der Mediathek, um sie im Archiv zu katalogisieren. Originale werden nie verändert.</string>
	<!-- Google-Maps-App erkennen (Umsehen-Funktion im Punkt-Check):
	     ohne diesen Eintrag darf canOpenURL das Schema nicht prüfen. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
	<!-- TestFlight/App Store Connect: Die App nutzt ausschließlich
	     Standard-HTTPS (ATS) — von der US-Exportmeldepflicht
	     ausgenommen. Der Eintrag beantwortet die Verschlüsselungs-
	     Frage bei jedem Upload dauerhaft mit „Nein". -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
