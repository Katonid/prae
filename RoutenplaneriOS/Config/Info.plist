<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Die App ist deutsch und bringt keine Sprachdateien mit. Ohne diese
	     beiden Schlüssel setzt Xcode „en", und iOS zeigt ALLES Systemeigene
	     englisch (Ortungsdialog, Teilen-Blatt). Lehre aus Tafelbild 1.0.59. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
	</array>

	<!-- Nur „WhenInUse", auch für die Aufzeichnung (ab 1.0.5): Eine im
	     Vordergrund gestartete Aufzeichnung läuft mit dem Hintergrundmodus
	     „location" und einer CLBackgroundActivitySession weiter, ohne
	     „Immer". -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Damit „Mein Standort" als Start oder Ziel gewählt werden kann und damit sich die gefahrene Strecke aufzeichnen lässt. Für die Route wird der Standort nur als Koordinate an den Routendienst geschickt; die Aufzeichnung bleibt auf dem Gerät.</string>

	<!-- Die einzige Hintergrundarbeit dieser App: eine laufende
	     Aufzeichnung. Ohne diesen Eintrag stürzt
	     `allowsBackgroundLocationUpdates = true` ab. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<!-- Ist nur die ungefähre Ortung erlaubt, fragt die Aufzeichnung
	     einmalig nach der genauen. Der Schlüssel heißt „Aufzeichnung". -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>Aufzeichnung</key>
		<string>Mit der ungefähren Ortung liegt jeder Punkt der Aufzeichnung mehrere hundert Meter daneben. Für die Strecke braucht die App den genauen Standort.</string>
	</dict>
</dict>
</plist>
