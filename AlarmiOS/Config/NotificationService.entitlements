<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Die Erweiterung braucht dieselbe Berechtigung wie die App: Sie setzt
	     interruptionLevel = .timeSensitive, und ohne dieses Entitlement wird
	     der Wert stillschweigend auf .active heruntergestuft — der Alarm käme
	     an, aber ein aktiver Fokus hielte ihn zurück. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
