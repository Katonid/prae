{
  "rules": {
    "klassenraum": {
      "shares": {
        "$code": {
          ".read": true,
          ".write": true
        }
      },
      "links": {
        "$code": {
          ".read": true,
          ".write": true
        }
      },
      "spaces": {
        "$space": {
          ".read": true,
          ".write": true
        }
      },
      "media": {
        "$space": {
          ".read": true,
          ".write": true
        }
      },
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "woerterwerkstatt": {
      "klassen": {
        "$code": {
          ".read": true,
          ".write": true
        }
      },
      "geheim": {
        "$code": {
          "$kind": {
            ".read": false,
            ".write": "!data.exists() || (auth != null && auth.uid === root.child('woerterwerkstatt/klassen/' + $code + '/besitzer').val())",
            ".validate": "newData.isString() && newData.val().length == 64"
          }
        }
      },
      "anmeldung": {
        "$code": {
          "$kind": {
            ".read": false,
            ".write": "newData.val() === root.child('woerterwerkstatt/geheim/' + $code + '/' + $kind).val()"
          }
        }
      },
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
