# Copy to keystore.properties (which stays out of Git) and fill in.
# Create the keystore once with:
#   keytool -genkeypair -v -keystore notfallalarm.jks -alias notfallalarm \
#           -keyalg RSA -keysize 4096 -validity 10000
storeFile=notfallalarm.jks
storePassword=CHANGE_ME
keyAlias=notfallalarm
keyPassword=CHANGE_ME
