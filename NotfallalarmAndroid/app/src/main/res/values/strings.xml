    <!-- Checklist -->
    <string name="checklist_title">Ist Ihr Gerät bereit?</string>
    <string name="checklist_intro">Damit der Alarm auch nachts und bei lautlosem Handy ankommt, braucht die App ein paar Freigaben. Jeder Punkt führt Sie direkt an die richtige Stelle.</string>
    <string name="checklist_open_settings">Einstellung öffnen</string>
    <string name="checklist_ok">Erledigt</string>
    <string name="checklist_missing">Fehlt</string>
    <string name="checklist_recommended">empfohlen</string>
    <string name="checklist_required">nötig</string>
    <string name="checklist_notifications">Benachrichtigungen erlauben</string>
    <string name="checklist_notifications_desc">Ohne diese Freigabe zeigt Android gar keine Alarmmeldung an.</string>
    <string name="checklist_fullscreen">Vollbild-Benachrichtigungen</string>
    <string name="checklist_fullscreen_desc">Damit der Alarm den Bildschirm einschaltet, statt nur oben eine Zeile zu zeigen.</string>
    <string name="checklist_battery">Akku-Optimierung ausschalten</string>
    <string name="checklist_battery_desc">Sonst legt Android die App nach einiger Zeit schlafen und der Alarm kommt verspätet oder gar nicht.</string>
    <string name="checklist_dnd">Zugriff auf „Nicht stören“</string>
    <string name="checklist_dnd_desc">Damit der Alarmton auch dann zu hören ist, wenn „Nicht stören“ eingeschaltet ist.</string>
    <string name="checklist_selftest">Selbsttest</string>
    <string name="checklist_selftest_desc">Zum Schluss schickt die App sich selbst einen Testalarm. Erst wenn der wirklich ankommt, ist alles eingerichtet.</string>
    <string name="checklist_selftest_start">Selbsttest starten</string>
    <string name="checklist_selftest_waiting">Warte auf den Testalarm …</string>
    <string name="checklist_selftest_ok">Der Testalarm ist angekommen.</string>
    <string name="checklist_selftest_failed">Der Testalarm ist nicht angekommen. Gehen Sie die Punkte oben noch einmal durch.</string>
    <string name="checklist_all_done">Alles erledigt – Ihr Gerät ist bereit.</string>
    <string name="checklist_finish">Fertig</string>

    <!-- Manufacturer hints -->
    <string name="hint_samsung_title">Samsung: App nicht schlafen legen</string>
    <string name="hint_samsung_text">Einstellungen → Akku → Nutzung im Hintergrund → „Apps im Ruhezustand“. Notfallalarm darf dort NICHT stehen. Zusätzlich unter „Nie schlafende Apps“ eintragen.</string>
    <string name="hint_xiaomi_title">Xiaomi: Autostart und keine Einschränkungen</string>
    <string name="hint_xiaomi_text">Einstellungen → Apps → Notfallalarm → „Autostart“ einschalten und unter „Energiesparen“ auf „Keine Einschränkungen“ stellen.</string>
    <string name="hint_huawei_title">Huawei/Honor: App-Start selbst verwalten</string>
    <string name="hint_huawei_text">Einstellungen → Akku → App-Start → Notfallalarm auf „Manuell verwalten“ stellen und alle drei Schalter (Autostart, Sekundärstart, im Hintergrund laufen) einschalten.</string>
    <string name="hint_oppo_title">Oppo/OnePlus/Realme: Hintergrund erlauben</string>
    <string name="hint_oppo_text">Einstellungen → Akku → Energieverbrauch der App → Notfallalarm → „Hintergrundaktivität zulassen“ und „Autostart“ einschalten.</string>
    <string name="hint_vivo_title">Vivo: Hochverbrauch im Hintergrund erlauben</string>
    <string name="hint_vivo_text">Einstellungen → Akku → Hintergrund-Energieverbrauch → Notfallalarm zulassen. Zusätzlich unter „Autostart“ einschalten.</string>
    <string name="hint_generic_title">Zusätzliche Einstellung Ihres Herstellers</string>
    <string name="hint_generic_text">Viele Hersteller legen Apps eigenmächtig schlafen. Suchen Sie in den Einstellungen nach „Akku“ oder „Autostart“ und nehmen Sie Notfallalarm von allen Einschränkungen aus.</string>
    <string name="hint_done">Habe ich erledigt</string>

