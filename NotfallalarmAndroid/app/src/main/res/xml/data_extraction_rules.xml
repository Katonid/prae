<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Nothing is backed up: the FCM token and the group membership belong to one
         installation on one phone, and a restored copy would only produce a member
         entry that can never be reached. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
