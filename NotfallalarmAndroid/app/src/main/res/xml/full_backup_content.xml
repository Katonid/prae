<?xml version="1.0" encoding="utf-8"?>
<!-- Counterpart of data_extraction_rules.xml for Android 11 and below. Backup is off
     anyway (allowBackup="false"); this file exists so both platform generations say the
     same thing instead of one of them falling back to a default. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
